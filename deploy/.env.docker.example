APP_NAME="Malas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Database (Postgres, container 'db' in docker-compose.yml) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=malas
DB_USERNAME=malas
DB_PASSWORD=ganti_password_kuat_disini

# --- Session / Cache / Queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log

# --- Storage ---
FILESYSTEM_DISK=local
# Series/volume covers are NOT configured via .env — the driver (local/S3-compatible,
# including homelab MinIO) is set via the admin UI at /admin/settings/storage.

# --- Mail (optional, for due date reminders / login without SSO) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@malas.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- SSO Yado ---
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:8080/auth/callback
SSO_BASE_URL=https://sso.yado.my.id

# --- Nginx (host port, see docker-compose.yml) ---
APP_PORT=8080
